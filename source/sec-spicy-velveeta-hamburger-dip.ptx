<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-spicy-velveeta-hamburger-dip" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Spicy Velveeta Hamburger Dip</title>
    <introduction>
        <p>
            IMAGE TO COME
        </p>
    </introduction>

    <paragraphs>
        <title>Ingredients</title>
        <p></p>
        <p>
            <alert>Yield:</alert> Makes one 4.5 quart crock-pot
        </p>
        <p>
            <dl>
                <li>
                    <title>Hot Taco Sauce</title>
                    <p>
                        16 oz (e.g. Ortega brand)
                    </p>
                </li>
                <li>
                    <title>Mild Taco Sauce</title>
                    <p>
                        16 oz (e.g. Ortega brand)
                    </p>
                </li>
                <li>
                    <title>Canned diced green chiles</title>
                    <p>
                        8 oz
                    </p>
                </li>
                <li>
                    <title>Sugar</title>
                    <p>
                        2 tablespoon
                    </p>
                </li>
                <li>
                    <title>Ground Black Pepper</title>
                    <p>
                        1.5 teaspoons
                    </p>
                </li>
                <li>
                    <title>Paprika</title>
                    <p>
                        4 teaspoons
                    </p>
                </li>
                <li>
                    <title>Velveeta</title>
                    <p>
                        4 pounds, cubed
                    </p>
                </li>
                <li>
                    <title>White vinegar</title>
                    <p>
                        2 Tablespoons
                    </p>
                </li>
                <li>
                    <title>Scallions</title>
                    <p>
                        2 bunches, chopped
                    </p>
                </li>
                <li>
                    <title>Salt</title>
                    <p>
                        1 teaspoon
                    </p>
                </li>
                <li>
                    <title>Garlic Powder</title>
                    <p>
                        0.75 teaspoon
                    </p>
                </li>
                <li>
                    <title>Ground beef</title>
                    <p>
                        2 pounds, browned
                    </p>
                </li>
            </dl>
        </p> 
    </paragraphs>

    <paragraphs>
        <title>Steps</title>
        <p>
            <ol>
                <li>
                    <p>
                        Simmer all ingredients (except beef and Velveeta) in a saucepan for 1 hour.
                    </p>
                </li>
                <li>
                    <p>
                        Add Velveeta until melted.
                    </p>
                </li>
                <li>
                    <p>
                        Add browned ground beef.
                    </p>
                </li>
                <li>
                    <p>
                        Transfer to crock-pot and keep warm on low heat.
                    </p>
                </li>
            </ol>
        </p>
        <p>
            <alert>Tip:</alert> Make 1-2 days in advance for best blending of flavors.
        </p>
    </paragraphs>
</section>