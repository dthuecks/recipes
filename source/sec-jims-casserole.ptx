<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-jims-casserole" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Jim's casserole</title>

    <introduction>
        <p>
            Source: Jim Butz
        </p>
        <p>
            IMAGE TO COME
        </p>
    </introduction>

    <paragraphs>
        <title>Ingredients</title>
        <p></p>
        <p>
            <alert>Yield:</alert> Approximately 6-8 servings.
        </p>
        <p>
            <dl>
                <li>
                    <title>Tomato sauce</title>
                    <p>
                        16 oz can
                    </p>
                </li>
                <li>
                    <title>Ground beef</title>
                    <p>
                        1 pound
                    </p>
                </li>
                <li>
                    <title>Diced tomatoes</title>
                    <p>
                        16 oz can
                    </p>
                </li>
                <li>
                    <title>Elbow macaroni</title>
                    <p>
                        1 cup, uncooked
                    </p>
                </li>
                <li>
                    <title>Garlic salt</title>
                    <p>
                        1 tsp
                    </p>
                </li>
                <li>
                    <title>Italian seasoning</title>
                    <p>
                        1 tsp
                    </p>
                </li>
                <li>
                    <title>Ground black pepper</title>
                    <p>
                        One dash
                    </p>
                </li>
                <li>
                    <title>Worcestershire sauce</title>
                    <p>
                        6 shakes
                    </p>
                </li>
                <li>
                    <title>Cheddar cheese</title>
                    <p>
                        Sliced, enough to cover two layers. Approximately 12-14 oz.
                    </p>
                </li>
            </dl>
        </p> 
    </paragraphs>

    <paragraphs>
        <title>Steps</title>
        <p>
            <ol>
                <li>
                    <p>
                        Brown the ground beef.
                    </p>
                </li>
                <li>
                    <p>
                        Cook the macaroni.
                    </p>
                </li>
                <li>
                    <p>
                        To the meat, add tomatoes, tomato sauce, garlic salt, Italian seasoning, pepper, and Worcestershire sauce. Simmer for 5-10 minutes.
                    </p>
                </li>
                <li>
                    <p>
                        Put half of the mixture into a glass or stoneware baking dish and cover with cheese slices.
                    </p>
                </li>
                <li>
                    <p>
                        Add the remaining mixture and cover again with cheese slices.
                    </p>
                </li>
                <li>
                    <p>
                        Heat in microwave until cheese melts, approximately 10 minutes.
                    </p>
                </li>
            </ol>
        </p>
        <p>
            <alert>Note:</alert> To make in a skillet, add 1 cup of hot water, 1 1/2 cups macaroni, and cook for 20 minutes.
        </p>
    </paragraphs>

    

</section>