<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-green-chile" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Green Chile</title>

    <introduction>
        <p>
        Source: Sharon Butz.  
        </p>
        <p>
            Original source is unknown.
        </p>
        <p>
            IMAGE TO COME
        </p>
    </introduction>

    <paragraphs>
        <title>Ingredients</title>
        <p></p>
        <p>
            <dl>
                <li>
                    <title>Olive oil</title>
                    <p>
                        
                    </p>
                </li>
                <li>
                    <title>Flour or masa</title>
                    <p>
                        Approx. 1 Tbsp
                    </p>
                </li>
                <li>
                    <title>Pork chops</title>
                    <p>
                        2 pounds, cubed (1/2 inch sides)
                    </p>
                </li>
                <li>
                    <title>Canned diced tomatoes</title>
                    <p>
                        2 pounds
                    </p>
                </li>
                <li>
                    <title>Beef consommé soup</title>
                    <p>
                        1 can, often Campbell's brand
                    </p>
                </li>
                <li>
                    <title>Green chiles</title>
                    <p>
                        8 oz, diced or cut in strips
                    </p>
                </li>
                <li>
                    <title>Lemon juice</title>
                    <p>
                        2 Tbsp
                    </p>
                </li>
                <li>
                    <title>Garlic</title>
                    <p>
                        2 cloves, crushed or minced
                    </p>
                </li>
                <li>
                    <title>Sugar</title>
                    <p>
                        1/2 tsp
                    </p>
                </li>
                <li>
                    <title>Ground cumin</title>
                    <p>
                        2 tsp
                    </p>
                </li>
                <li>
                    <title>Parsley flakes and salt</title>
                    <p>
                        To taste
                    </p>
                </li>
            </dl>
        </p> 
    </paragraphs>

    <paragraphs>
        <title>Steps</title>
        <p>
            <ol>
                <li>
                    <p>
                        Brown pork on all sides in a small amount of olive oil. Drain grease when finished.
                    </p>
                </li>
                <li>
                    <p>
                        Add pork and remaining ingredients to a crock pot.
                    </p>
                </li>
                <li>
                    <p>
                        Cook on low for six hours or more. 
                    </p>
                </li>
                <li>
                    <p>
                        To thicken (optional): Before serving, remove a small amount of liquid from the crockpot and mix in flour or masa. Stir well. Add mixture to the crockpot slowly while stirring.
                    </p>
                </li>
            </ol>
        </p>
        <p>
            <alert>Note:</alert> Thickening step is optional but might be desirable if intending to smother other food with the chile.
        </p>
        
    </paragraphs>

    

</section>