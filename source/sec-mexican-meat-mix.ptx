<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-mexican-meat-mix" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Mexican meat mix</title>

    <introduction>
        <p>
        Source: Sharon Butz.  
        </p>
        <p>
            Original source is unknown.
        </p>
        <p>
            IMAGE TO COME
        </p>
    </introduction>

    <paragraphs>
        <title>Ingredients</title>
        <p></p>
        <p>
            <alert>Yield:</alert> Approximately 9 cups of meat mix.
        </p>    
        <p>
            <dl>
                <li>
                    <title>Combination beef and pork roasts</title>
                    <p>
                        5 pounds total
                    </p>
                </li>
                <li>
                    <title>Olive oil</title>
                    <p>
                        3 Tbsp
                    </p>
                </li>
                <li>
                    <title>Onions</title>
                    <p>
                        Three, diced
                    </p>
                </li>
                <li>
                    <title>Chopped green chiles</title>
                    <p>
                        One 4-oz can
                    </p>
                </li>
                <li>
                    <title>Green chile and tomatillo salsa</title>
                    <p>
                        Two 7-oz cans
                    </p>
                </li>
                <li>
                    <title>Garlic powder</title>
                    <p>
                        1/4 tsp
                    </p>
                </li>
                <li>
                    <title>Flour</title>
                    <p>
                        4 Tbsp
                    </p>
                </li>
                <li>
                    <title>Salt</title>
                    <p>
                        4 tsp
                    </p>
                </li>
                <li>
                    <title>Ground cumin</title>
                    <p>
                        1 tsp
                    </p>
                </li>
            </dl>
        </p> 
    </paragraphs>

    <paragraphs>
        <title>Steps</title>
        <p>
            <ol>
                <li>
                    <p>
                        Place roasts (fat side up) in crockpot and cook on low for 8 or more hours.
                    </p>
                </li>
                <li>
                    <p>
                        Drain meat, reserving juices.
                    </p>
                </li>
                <li>
                    <p>
                        Shred meat and set aside.
                    </p>
                </li>
                <li>
                    <p>
                        Heat olive oil and then saute onions and green chiles until onions are soft.
                    </p>
                </li>
                <li>
                    <p>
                        Add tomatillo salsa, garlic powder, flour, salt, and cumin. Cook for 1 minute over medium-low heat.
                    </p>
                </li>
                <li>
                    <p>
                        Stir in reserved meat juices and shredded meat. Cook for 5 minutes or until thick.
                    </p>
                </li>

            </ol>
        </p>
        
    </paragraphs>

</section>